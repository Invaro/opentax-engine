{
  "name": "@invaro/opentax-compose",
  "version": "0.1.0",
  "description": "Printed-form line composers for state returns (IL-1040, VA 760, CA 540, NY IT-201): deterministic whole-dollar composition over injected corpus tax evaluators",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Invaro/opentax-engine.git",
    "directory": "packages/compose"
  },
  "homepage": "https://github.com/Invaro/opentax-engine#readme",
  "bugs": {
    "url": "https://github.com/Invaro/opentax-engine/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tax",
    "state-tax",
    "form-1040",
    "state-returns"
  ],
  "private": true
}
