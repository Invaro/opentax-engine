{
  "name": "opentax-engine",
  "private": true,
  "version": "0.1.0",
  "description": "Verifiable US tax engine \u2014 every answer ships with a machine-checkable proof",
  "license": "BUSL-1.1",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "opentax": "node packages/cli/dist/bin.js",
    "demo": "node packages/cli/dist/bin.js eval --status mfj --wages 120000 --kids 2"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "esbuild": "0.28.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.4",
      "@hono/node-server": ">=2.0.5",
      "vite": ">=7.3.7 <8"
    }
  }
}
